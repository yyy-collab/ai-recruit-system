{
  "openapi": "3.0.3",
  "info": {
    "title": "AI 招聘猎头系统 API",
    "description": "基于 HanLP + TF-IDF + 余弦相似度的智能招聘系统",
    "version": "1.13",
    "contact": {}
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "生产环境"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CommonResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "0成功，其他见错误码"
          },
          "msg": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "nullable": true
          }
        }
      },
      "SeekerRegisterRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 5,
            "maxLength": 16,
            "pattern": "^[a-zA-Z0-9_]{5,16}$"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 16,
            "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{8,16}$"
          }
        }
      },
      "SeekerLoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "SeekerUpdateRequest": {
        "type": "object",
        "properties": {
          "real_name": { "type": "string", "minLength": 2, "maxLength": 20 },
          "avatar_url": { "type": "string" },
          "phone": { "type": "string", "pattern": "^1[3-9]\\d{9}$" },
          "email": { "type": "string", "format": "email" },
          "age": { "type": "integer", "minimum": 16, "maximum": 65 },
          "address": { "type": "string" },
          "edu_back": { "type": "string", "enum": ["专科", "本科", "硕士", "博士"] },
          "alma_mater": { "type": "string" },
          "state": { "type": "string", "enum": ["在职", "离职", "应届毕业生"] },
          "ex_postion": { "type": "string" },
          "ex_city": { "type": "string" },
          "ex_salary_min": { "type": "integer" },
          "ex_salary_max": { "type": "integer" }
        }
      },
      "UpdatePwdRequest": {
        "type": "object",
        "required": ["old_pwd", "new_pwd", "re_pwd"],
        "properties": {
          "old_pwd": { "type": "string" },
          "new_pwd": { "type": "string", "pattern": "^(?=.*[A-Za-z])(?=.*\\d)[A-Za-z\\d]{8,16}$" },
          "re_pwd": { "type": "string" }
        }
      },
      "ResetPwdRequest": {
        "type": "object",
        "required": ["username", "email", "code", "new_pwd", "re_pwd"],
        "properties": {
          "username": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "code": { "type": "string", "minLength": 6, "maxLength": 6 },
          "new_pwd": { "type": "string" },
          "re_pwd": { "type": "string" }
        }
      },
      "JobAddRequest": {
        "type": "object",
        "required": ["job_name", "job_desc", "requirement", "keywords"],
        "properties": {
          "job_name": { "type": "string" },
          "job_desc": { "type": "string" },
          "requirement": { "type": "string" },
          "keywords": { "type": "string", "description": "逗号分隔" },
          "salary": { "type": "string", "example": "15-25K" },
          "work_address": { "type": "string" },
          "work_experience": { "type": "string", "example": "3-5年" }
        }
      },
      "JobUpdateRequest": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "integer" },
          "job_name": { "type": "string" },
          "job_desc": { "type": "string" },
          "requirement": { "type": "string" },
          "keywords": { "type": "string" },
          "salary": { "type": "string" },
          "work_address": { "type": "string" },
          "work_experience": { "type": "string" }
        }
      },
      "ChangeJobStatusRequest": {
        "type": "object",
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "integer" },
          "status": { "type": "integer", "enum": [0, 1], "description": "1上线0下线" }
        }
      },
      "DeliveryAddRequest": {
        "type": "object",
        "required": ["job_id"],
        "properties": {
          "job_id": { "type": "integer" }
        }
      },
      "DeliveryUpdateStatusRequest": {
        "type": "object",
        "required": ["delivery_id", "status"],
        "properties": {
          "delivery_id": { "type": "integer" },
          "status": { "type": "integer", "enum": [0, 1, 2], "description": "0待处理1通过2淘汰" },
          "comment": { "type": "string" }
        }
      },
      "BatchUpdateStatusRequest": {
        "type": "object",
        "required": ["delivery_ids", "status"],
        "properties": {
          "delivery_ids": { "type": "array", "items": { "type": "integer" } },
          "status": { "type": "integer", "enum": [0, 1, 2] },
          "reject_reason": { "type": "string" }
        }
      },
      "SendInterviewRequest": {
        "type": "object",
        "required": ["delivery_id", "interview_date", "interview_time", "interview_type", "interview_round", "interview_address", "contact_name", "contact_phone"],
        "properties": {
          "delivery_id": { "type": "integer" },
          "interview_date": { "type": "string", "format": "date" },
          "interview_time": { "type": "string", "pattern": "^([0-1]?[0-9]|2[0-3]):[0-5][0-9]$" },
          "interview_type": { "type": "string", "enum": ["线上面试", "现场面试", "电话面试"] },
          "interview_round": { "type": "string", "enum": ["初试", "复试", "终试"] },
          "interview_address": { "type": "string" },
          "contact_name": { "type": "string" },
          "contact_phone": { "type": "string", "pattern": "^1[3-9]\\d{9}$" },
          "remark": { "type": "string" }
        }
      },
      "HandleInterviewRequest": {
        "type": "object",
        "required": ["message_id", "status"],
        "properties": {
          "message_id": { "type": "integer" },
          "status": { "type": "integer", "enum": [1, 2], "description": "1接受2拒绝" },
          "reject_reason": { "type": "string" }
        }
      },
      "SegmentRequest": {
        "type": "object",
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "maxLength": 5000 }
        }
      },
      "KeywordExtractRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string", "enum": ["text", "resume", "job"] },
          "content": { "type": "string" },
          "resume_id": { "type": "integer" },
          "job_id": { "type": "integer" },
          "limit": { "type": "integer", "default": 10, "maximum": 20 }
        }
      },
      "MatchCalculateRequest": {
        "type": "object",
        "required": ["job_id", "resume_id"],
        "properties": {
          "job_id": { "type": "integer" },
          "resume_id": { "type": "integer" }
        }
      },
      "RecalculateMatchRequest": {
        "type": "object",
        "required": ["delivery_id"],
        "properties": {
          "delivery_id": { "type": "integer" }
        }
      },
      "VerifyCodeRequest": {
        "type": "object",
        "required": ["email", "type"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "type": { "type": "string", "enum": ["seeker_reset", "hr_reset"] }
        }
      }
    }
  },
  "paths": {
    "/seeker/register": {
      "post": {
        "summary": "求职者注册",
        "operationId": "seekerRegister",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SeekerRegisterRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CommonResponse" },
                "example": {
                  "code": 0,
                  "msg": "注册成功，请登录后完善个人信息",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/seeker/login": {
      "post": {
        "summary": "求职者登录",
        "operationId": "seekerLogin",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/SeekerLoginRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "msg": { "type": "string" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": { "type": "string" },
                        "expires_in": { "type": "integer" },
                        "is_info_complete": { "type": "boolean" }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/seeker/refreshToken": {
      "post": {
        "summary": "刷新求职者JWT令牌",
        "operationId": "seekerRefreshToken",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": {
            "description": "成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": { "type": "integer" },
                    "msg": { "type": "string" },
                    "data": {
                      "type": "object",
